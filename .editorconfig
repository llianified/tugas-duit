# Repo ini tidak memakai Prettier — gaya kode dijaga konvensi (lihat CLAUDE.md:
# tanpa titik koma, kutip tunggal). Berkas ini hanya menyamakan whitespace,
# supaya diff tidak pernah kotor cuma karena setelan editor yang berbeda.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Dua spasi di akhir baris adalah line break yang disengaja di Markdown.
trim_trailing_whitespace = false

[*.sql]
indent_size = 2

[{*.yml,*.yaml}]
indent_size = 2
