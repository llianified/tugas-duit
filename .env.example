# Database produksi: Railway PostgreSQL. Salin connection string dari tab "Variables"
# service Postgres di Railway (bentuknya postgresql://user:pass@host:port/db).
# TIDAK WAJIB untuk dev lokal — kalau DATABASE_URL kosong, server/db.ts otomatis
# jatuh ke PGlite in-process (server/preview-db.ts), tanpa perlu install Postgres apa pun.
# Kalau memang butuh data/skema asli saat dev, minta connection string Railway ke pemilik
# repo — jangan sarankan instalasi database baru.
DATABASE_URL=

# Set true hanya untuk koneksi dev ke Postgres dengan sertifikat self-signed. Diabaikan
# paksa di NODE_ENV=production (lihat sslConfig() di server/db.ts).
DATABASE_SSL_NO_VERIFY=false

# Kredensial bot Telegram (BotFather).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Origin publik aplikasi, dipakai untuk validasi & link balik (mis. https://tugasduit.app).
APP_ORIGIN=

# Opsional — login admin lokal tanpa akun Telegram admin.
ADMIN_PASSWORD=
ADMIN_TELEGRAM_ID=

# Iklan (opsional). GigaPub adalah jaringan yang aktif: isi project ID numerik dari
# dashboard giga.pub — angka yang muncul di URL script integrasi mereka
# (ad.gigapub.tech/script?id=ANGKA). Bukan token/API key.
#
# Adsgram sengaja dipertahankan di kode sebagai jalan pulang: kalau GigaPub
# mengecewakan, kosongkan NEXT_PUBLIC_GIGAPUB_PROJECT_ID dan isi blockId Adsgram —
# server/ad-provider.ts akan pindah jaringan tanpa perubahan kode. GigaPub selalu
# menang kalau dua-duanya terisi, jadi hanya satu SDK yang pernah dimuat.
#
# Kalau dua-duanya kosong, ads.enabled dari /api/session bernilai false, SDK-nya tidak
# dimuat, dan tombol iklan tidak dirender — dev lokal jalan tanpa akun jaringan iklan.
# Besaran plafon/cooldown/umur tiket bukan di sini, melainkan di panel admin (grup
# "Iklan"); adsMaxViewsPerDay=0 mematikan fiturnya tanpa deploy.
NEXT_PUBLIC_GIGAPUB_PROJECT_ID=
NEXT_PUBLIC_ADSGRAM_BLOCK_ID=
NEXT_PUBLIC_ADS_DEBUG=false
