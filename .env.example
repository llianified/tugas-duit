# Database produksi: Railway PostgreSQL. Salin connection string dari tab "Variables"
# service Postgres di Railway (bentuknya postgresql://user:pass@host:port/db).
# TIDAK WAJIB untuk dev lokal — kalau DATABASE_URL kosong, server/db.ts otomatis
# jatuh ke PGlite in-process (server/preview-db.ts), tanpa perlu install Postgres apa pun.
# Kalau memang butuh data/skema asli saat dev, minta connection string Railway ke pemilik
# repo — jangan sarankan instalasi database baru.
DATABASE_URL=

# Set true hanya untuk koneksi dev ke Postgres dengan sertifikat self-signed. Diabaikan
# paksa di NODE_ENV=production (lihat sslConfig() di server/db.ts).
DATABASE_SSL_NO_VERIFY=false

# Kredensial bot Telegram (BotFather).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Origin publik aplikasi, dipakai untuk validasi & link balik (mis. https://tugasduit.app).
APP_ORIGIN=

# Opsional — login admin lokal tanpa akun Telegram admin.
ADMIN_PASSWORD=
ADMIN_TELEGRAM_ID=

# Iklan — Monetag (rewarded interstitial). Isi zone ID numerik dari dashboard Monetag,
# yaitu angka yang dipasang di atribut data-zone pada script integrasi mereka. Bukan
# token/API key. Boleh dibiarkan kosong: kode jatuh ke zone default di domain/ads.ts,
# jadi dev lokal dan deploy lama tetap punya iklan yang jalan.
#
# Format iklannya sengaja hanya rewarded interstitial — tidak ada in-app interstitial,
# popup, atau push, karena satu tayangan harus ditukar satu tiket masuk task lewat
# /api/ads/ticket dan /api/ads/claim.
#
# Mematikan fitur iklan BUKAN dari sini, melainkan dari panel admin (grup "Iklan"):
# adsMaxViewsPerDay=0 mematikannya tanpa deploy. Plafon/cooldown/umur tiket juga di sana.
NEXT_PUBLIC_MONETAG_ZONE_ID=

# Channel Telegram untuk bonus join. Bot WAJIB jadi admin di channel ini — verifikasi
# keanggotaan memakai getChatMember, dan tanpa hak admin Telegram menolak permintaannya
# sehingga bonusnya tidak pernah bisa diklaim siapa pun (server menjawab "belum bisa dicek",
# bukan memberi bonus atas dasar tebakan).
#
# Boleh dikosongkan: default-nya @tugasduit / https://t.me/tugasduit.
# Besaran bonusnya BUKAN dari sini melainkan panel admin (grup "Channel"):
# channelJoinBonusCredits=0 mematikan kartunya tanpa deploy.
TELEGRAM_CHANNEL_ID=
TELEGRAM_CHANNEL_URL=

# Pembayaran langganan premium — KlikQRIS (QRIS dinamis).
#
# Ambil keduanya dari menu "Dokumentasi API" di dashboard KlikQRIS. Kalau salah satu
# kosong, fitur premium mati sendiri: kartunya tidak dirender dan /api/premium/checkout
# menjawab 503, jadi tidak ada jalur beli yang setengah jalan.
#
# Webhook-nya diarahkan ke $APP_ORIGIN/api/premium/webhook (dikirim per transaksi lewat
# callback_url, jadi tidak perlu disetel manual di dashboard). Yang membedakan callback
# asli dari POST karangan hanya `signature`, yang dicocokkan dengan signature tersimpan
# saat tagihan dibuat.
#
# Harga paket 1/2/3 bulan BUKAN dari sini melainkan panel admin (grup "Premium").
KLIKQRIS_API_KEY=
KLIKQRIS_MERCHANT_ID=

# Opsional — hanya untuk mengarahkan ke sandbox/mock. Kosong = https://klikqris.com/api.
KLIKQRIS_BASE_URL=
