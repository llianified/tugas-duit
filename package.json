{
  "name": "tugas-duit",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "deploy-build": "node --experimental-strip-types scripts/migrate.ts --deploy && node --experimental-strip-types scripts/cleanup-inactive-premium-withdrawals.ts --deploy && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node --env-file-if-exists=.env.development.local --experimental-strip-types scripts/migrate.ts",
    "db:cleanup": "node --env-file-if-exists=.env.development.local --experimental-strip-types scripts/maintenance.ts",
    "db:grant-admin": "node --env-file-if-exists=.env.development.local --experimental-strip-types scripts/grant-admin.ts",
    "db:ban-user": "node --env-file-if-exists=.env.development.local --experimental-strip-types scripts/ban-user.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@electric-sql/pglite": "^0.5.8",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "^19",
    "react-dom": "^19",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "postcss": "^8.5",
    "shadcn": "^4.20.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "hono": ">=4.12.34",
      "nanoid": ">=3.3.18"
    }
  }
}
